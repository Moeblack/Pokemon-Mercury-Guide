  "steps": [
    {
      "text": "在喇叭芽之塔找到与受伤波波在一起的阿速，看完剧情后在请求处回答“是”。",
      "source_scripts": [
        "0x08EE79FE",
        "0x08EE956A"
      ],
      "map_id": "52:2"
    },
    {
      "text": "接受委托，阿速请你向宝可梦学校的初始老师与喇叭芽之塔的长老请教 鸟为什么会飞（置接取旗标 2958）。",
      "source_scripts": [
        "0x08EE974A",
        "0x08EEB149"
      ],
      "map_id": "52:2"
    },
    {
      "text": "到桔梗市宝可梦学校找初始老师，获得科学解释，置旗标 2959。",
      "source_scripts": [
        "0x08EE7BD1",
        "0x08EE8AB8"
      ],
      "map_id": "46:7"
    },
    {
      "text": "到喇叭芽之塔内部找长老，获得宿命论解释，置旗标 2960。",
      "source_scripts": [
        "0x08EE8BD1",
        "0x08EEA266"
      ],
      "map_id": "1:90"
    },
    {
      "text": "两处都问过后回到阿速处，触发他自我怀疑与波波跳向塔缘的剧情。",
      "source_scripts": [
        "0x08EE97E3",
        "0x08EE9832",
        "0x08EEA883"
      ],
      "map_id": "52:2"
    },
    {
      "text": "在塔顶与阿速对战（trainerbattle0，训练家 390 阿速）。",
      "source_scripts": [
        "0x08EE997E"
      ],
      "map_id": "52:2"
    },
    {
      "text": "战胜后领取谢礼：10 BracerPoints、12000 金钱，大比鸟超级进化波动注入超级石，置完成旗标 3076。",
      "source_scripts": [
        "0x08EEA935",
        "0x08EEB149"
      ],
      "map_id": "52:2"
    }
