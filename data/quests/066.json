  "steps": [
    {
      "text": "与胡桃交谈，她为《城都风景特辑》缺绝景照片发愁。",
      "source_scripts": [
        "0x09CD3E67",
        "0x09CD3E72"
      ]
    },
    {
      "text": "满足前置后她请求去拍绝景照片；选「是」接受任务（setflag 2978）。",
      "source_scripts": [
        "0x09CD3E9B",
        "0x09CD3ED2"
      ]
    },
    {
      "text": "她列出四处（擂钵山山顶、海之彼岸孤崖、喇叭芽之塔塔顶、寂静之丘顶端），并提示海之彼岸的线索在浅葱市精灵中心。",
      "source_scripts": [
        "0x09CD3ED2",
        "0x09CD3F12",
        "0x09CD3F3B"
      ]
    },
    {
      "text": "喇叭芽之塔 (16,10)：调查选「是」拍照，记录进度（2982）后传送至拍照场景 52:3。",
      "source_scripts": [
        "0x087B06DF",
        "0x087B1710",
        "0x08EED360",
        "0x08EED376"
      ],
      "map_id": "52:2"
